#
# Recovery init additions for Samsung b2q.
#
# Diagnostic boot-first build: intentionally do not import
# init.recovery.qcom_decrypt.rc and do not start stock crypto HALs at boot.
# This isolates recovery UI startup from the FBE/QSEE/Keymaster path.

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # TWRP maps the dynamic system partition at /system_root on b2q.
    export ANDROID_ROOT /system_root

    # Keep firmware mounted exactly as in the normal tree. This is harmless for
    # the UI and preserves the rest of the device bring-up for comparison.
    mkdir /vendor/firmware_mnt
    mount vfat /dev/block/bootdevice/by-name/apnhlos /vendor/firmware_mnt ro

service twrp-otg-watch /system/bin/sh /system/bin/twrp-otg-watch.sh
    class core
    user root
    group root
    disabled

on boot
    start health-hal-2-1
    start twrp-otg-watch
